{
  "annotations": {
    "list": []
  },
  "description": "Fintech transaction processing system overview",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Transaction Rate (per second)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(fintech_transactions_total[5m])) by (service)",
          "legendFormat": "{{ service }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Transaction Success vs Failure",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(fintech_transactions_total{status=\"SUCCESS\"}[5m])) by (service)",
          "legendFormat": "{{ service }} success",
          "refId": "A"
        },
        {
          "expr": "sum(rate(fintech_transactions_total{status=\"FAILED\"}[5m])) by (service)",
          "legendFormat": "{{ service }} failed",
          "refId": "B"
        }
      ]
    },
    {
      "title": "HTTP Request Latency P95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(fintech_http_request_duration_seconds_bucket[5m])) by (le, service))",
          "legendFormat": "{{ service }} P95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "HTTP Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(fintech_http_requests_total{status_code=~\"5..\"}[5m])) by (service) / sum(rate(fintech_http_requests_total[5m])) by (service)",
          "legendFormat": "{{ service }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "fintech_kafka_consumer_lag",
          "legendFormat": "{{ group }} on {{ topic }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Kafka Messages Produced/Consumed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(fintech_kafka_messages_produced_total[5m])) by (topic)",
          "legendFormat": "produced: {{ topic }}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(fintech_kafka_messages_consumed_total[5m])) by (topic)",
          "legendFormat": "consumed: {{ topic }}",
          "refId": "B"
        }
      ]
    },
    {
      "title": "DB Query Latency P95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(fintech_db_query_duration_seconds_bucket[5m])) by (le, operation))",
          "legendFormat": "{{ operation }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "Redis Operation Latency P95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(fintech_redis_operation_duration_seconds_bucket[5m])) by (le, operation))",
          "legendFormat": "{{ operation }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "Error Rate by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "sum(rate(fintech_errors_total[5m])) by (service, type)",
          "legendFormat": "{{ service }}: {{ type }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Active Connections",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "fintech_active_connections",
          "legendFormat": "{{ service }}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["fintech", "transactions"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Fintech Transaction Processing",
  "uid": "fintech-main",
  "version": 1
}
